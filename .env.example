# Servora Core Environment Configuration Template
NODE_ENV=development
PORT=3000

# Security & Session Secrets
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars
QR_SIGNING_SALT=replace-with-secure-qr-hmac-salt

# Database Configuration (PostgreSQL with RLS)
DATABASE_URL=postgresql://servora:servora_dev_pass@localhost:5432/servora_dev

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379

# Payment Gateway (PCI-DSS SAQ-A Hosted Fields)
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
